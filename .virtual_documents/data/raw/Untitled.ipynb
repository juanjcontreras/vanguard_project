import sys
from pathlib import Path

print(sys.executable)
print(Path.cwd())





import pandas as pd



df = pd.read_csv("df_final_demo.txt")


df.head(15)


df.info()


#create a clean copy
df_clean = df.copy()


df_clean.shape


#check missing values
df_clean.isna().sum()


#To see the rows containing missing values
df_clean[df_clean.isna().any(axis=1)]


#drop all missing values
important_columns = [
    "clnt_tenure_yr",
    "clnt_tenure_mnth",
    "clnt_age",
    "gendr",
    "num_accts",
    "bal",
    "calls_6_mnth",
    "logons_6_mnth"
]

df_clean = df_clean.dropna(
    subset=important_columns,
    how="all"
)


df_clean[df_clean["clnt_age"].isna()]


median_age = df_clean["clnt_age"].median()

df_clean["clnt_age"] = df_clean["clnt_age"].fillna(median_age)


df_clean.isna().sum()


df_clean.head(9583)


df_clean["gendr"].value_counts(dropna=False)


df_clean["gendr"] = (
    df_clean["gendr"]
    .str.strip()
    .str.upper()
    .replace("X", "U")
)


df_clean["gendr"].value_counts()


df_clean.duplicated().sum()


integer_columns = [
    "clnt_tenure_yr",
    "clnt_tenure_mnth",
    "num_accts",
    "calls_6_mnth",
    "logons_6_mnth"
]

df_clean[integer_columns] = df_clean[integer_columns].astype(int)


df_clean.dtypes


df_clean.describe()



